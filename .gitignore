# Python
# Без префикса пути — venv может лежать и в корне, и в backend/; правило `backend/.venv/`
# корневой не покрывало, и он попадал в `git add -A` двадцатью с лишним мегабайтами.
.venv/
__pycache__/
*.pyc
backend/.env

# Node / Electron
client/node_modules/
client/dist/

# Данные сессий (фонограммы, протоколы) — не коммитим
backend/storage/sessions/
*.wav

# Шаблоны анкеты — генерируются автоматически при первом запуске (TemplateStore засеивает
# builtin-шаблон), коммитить нечего.
backend/storage/templates/

# Профиль оператора (Блок 6) — реальные персональные данные пользователя программы (ФИО/
# должность следователя и т.п.), локальный рантайм-файл, не для репозитория.
backend/storage/operator_profile.json

# Модели ASR (кэш)
backend/models/

# Пакетная расшифровка: декодированный звук и чекпойнты (гигабайты, восстановимы)
.transcribe-work/
*.pcm
